wOVowKTEPMA0GA1UECgwGRHN0YWNrMRYw\nFAYDVQQDDA1Ec3RhY2sgS01TIENBMFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAE\nOUqu0sdF5qRXy4Nff0dCP1f/Pq1xuSq/9r3BTZBbMZ8uE5YbQsUHQNrkSY2cUd16\nLiJ2YMnlxQQIPNoGtsEWgqNGMEQwDwYDVR0PAQH/BAUDAweGADAdBgNVHQ4EFgQU\nBztQMiWLK//tA8AWAMtC1OpZA2wwEgYDVR0TAQH/BAgwBgEB/wIBATAKBggqhkjO\nPQQDAgNIADBFAiBXzKOwQVOgWCuTqMCeIASP6WtY4EGecKVYAJuNsHBqlgIhALfn\nSnNioxS6l2zWUWHUZPXx+VXX5D8A15PjyuKUKiSb\n-----END CERTIFICATE-----\n","tcb_info":{"mrtd":"7fe60787222bd394cb516abca2435f22f035ab2cc9c0a4b4b3b148e46297f3d931a237b72f359052c6e657d8c1409173","rtmr0":"d090162bff4b1d1dc74dc59dc548838efc4b811b173da8536efa8e2a9c045da70ee092301293ad90afebee448bcd0211","rtmr1":"4ae609807c765916a31d724786ed74bcb97e168a9d937b04936aeef2015c907eba5ac352c6bcd749c246fd62ffb659ec","rtmr2":"764489f277a8540189761e72b4238ba36d4d647e11bd958d8ab5522af2a4867b0ff63e06b0c4967f1857236244040a5d","rtmr3":"443409ab8b848f88ece95baa6b5ca193d69bcf817a8f23fe25144c33fe90f77bdc921de16064e89d780effe9bedc335e","os_image_hash":"8db40cb23008d6213668b5816702d100b37b859a8a5bfd18d938ae3a1b3715bd","compose_hash":"b73eed6abc60fbe5eb0ce2bbaacf3bd9b83c9c84f3e6a5b1a091cb679bdbe66f","device_id":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","app_compose":"{\"manifest_version\":2,\"name\":\"dstack-0.5.12\",\"runner\":\"docker-compose\",\"docker_compose_file\":\"# Docker Compose configuration for Cloud API in a VPC environment\\n# This setup includes the dstack-service for VPC management and an init container\\n# to prepare necessary configuration files before starting the Cloud API service.\\n\\nservices:\\n  \\n  # OpenTelemetry collector sidecar for in-CVM logs/metrics/traces.\\n  otelcol-contrib:\\n    image: otel/opentelemetry-collector-contrib@sha256:85ac41c2db88d0df9bd6145e608a3cb023f5d8443868adbfbbf66efb51087917\\n    container_name: otelcol-contrib\\n    command: [\\\"--config=/etc/otelcol-contrib/config.yaml\\\"]\\n    user: \\\"0:0\\\"\\n    mem_limit: \\\"512m\\\"\\n    environment:\\n      - MONITORING_INGEST_TOKEN=${MONITORING_INGEST_TOKEN}\\n      - CVM_NAME=${CVM_NAME}\\n      - CVM_HOST=${CVM_HOST}\\n      - DD_HOSTNAME=${DD_HOSTNAME}\\n      - ENV=${ENV}\\n      - CVM_HOSTMETRICS_ROOT_PATH=/hostfs\\n      \\n    expose:\\n      - \\\"4317\\\"\\n      - \\\"4318\\\"\\n    volumes:\\n      # Required for Prometheus docker_sd_configs. The scrape rules below only\\n      # keep containers explicitly labeled nearai.otel.scrape=true.\\n      - /var/run/docker.sock:/var/run/docker.sock:ro\\n      # Required for CVM guest hostmetrics parity. OTel prefixes host mount\\n      # points with root_path=/hostfs so the collector reports the guest host,\\n      # not the collector container filesystem.\\n      - /:/hostfs:ro\\n      - /var/lib/docker/containers:/var/lib/docker/containers:ro\\n      \\n      - otelcol-identity:/telemetry:ro\\n      \\n      - otelcol-storage:/var/lib/otelcol-contrib\\n    configs:\\n      - source: otelcol_cvm_config\\n        target: /etc/otelcol-contrib/config.yaml\\n        mode: 0444\\n    \\n    # Identity-enabled CVMs declare their startup prerequisites through\\n    # cvm_telemetry_depends_on_config.\\n    depends_on:\\n        api-init:\\n          condition: service_completed_successfully\\n\\n    \\n    restart: unless-stopped\\n    # Avoid the collector tailing its own Docker JSON log and creating a\\n    # feedback loop. The host-side Phase 1 collector still captures VM\\n    # serial/stderr if this sidecar itself needs debugging.\\n    logging:\\n      driver: \\\"local\\\"\\n      options:\\n        max-size: \\\"20m\\\"\\n        max-file: \\\"3\\\"\\n\\n\\n  # Init container to prepare configuration\\n  api-init:\\n    image: alpine@sha256:4b7ce07002c69e8f3d704a9c5d6fd3053be500b7f1c69fc0d80990c2ad8dd412\\n    container_name: api-init\\n    restart: \\\"no\\\"\\n    volumes:\\n      - api_config:/config\\n      - otelcol-identity:/telemetry\\n    environment:\\n      # Base64 survives the host .env / encrypted dstack env / Compose pipeline.\\n      - CLOUD_API_RDS_PASSWORD_B64=${CLOUD_API_RDS_PASSWORD_B64:?RDS password required}\\n      - CLOUD_API_RDS_CA_BUNDLE_B64=${CLOUD_API_RDS_CA_BUNDLE_B64:?RDS CA bundle required}\\n    dns:\\n      - 1.1.1.1\\n    configs:\\n      - source: api_init_script\\n        target: /init.sh\\n        mode: 0755\\n    command: [\\\"/init.sh\\\"]\\n\\n  # Cloud API service\\n  cloud-api:\\n    container_name: cloud-api\\n    image: nearaidev/cloud-api@sha256:cacddc688a43f673d1d7ca3ecea6d953ae89e19c6aa08681517658cb71f2698e\\n    restart: unless-stopped\\n    volumes:\\n      - /var/run/dstack.sock:/var/run/dstack.sock\\n      - api_config:/config:ro\\n      - ingress_certs:/ingress-certs:ro\\n    environment:\\n      - DATABASE_CONNECTION_MODE=direct\\n      - DATABASE_HOST=cloudapi-postgres-prod.cx0gm2caeqha.us-east-1.rds.amazonaws.com\\n      - DATABASE_PORT=5432\\n      - DATABASE_TLS_CA_CERT_PATH=/config/rds-ca-bundle.pem\\n      - SERVER_HOST=0.0.0.0\\n      - SERVER_PORT=3000\\n      - DATABASE_MAX_CONNECTIONS=32\\n      - DATABASE_REFRESH_INTERVAL=300\\n      - MODEL_DISCOVERY_SERVER_URL=${MODEL_DISCOVERY_SERVER_URL}\\n      - MODEL_DISCOVERY_API_KEY=${MODEL_DISCOVERY_API_KEY}\\n      # Per-model GPU allocation and burn metrics for the admin dashboard.\\n      # Values are written to the CVM .env file from the environment-specific\\n      # vars file and must also be forwarded into the cloud-api container.\\n      - INFRA_PROMETHEUS_URL=${INFRA_PROMETHEUS_URL}\\n      - INFRA_PROMETHEUS_BEARER_TOKEN=${INFRA_PROMETHEUS_BEARER_TOKEN}\\n      - INFRA_PROMETHEUS_ENV=${INFRA_PROMETHEUS_ENV}\\n      - INFRA_COST_PER_GPU_HOUR_USD=${INFRA_COST_PER_GPU_HOUR_USD}\\n      - ENABLE_ITA_ATTESTATION=true\\n      - ITA_API_KEY=${ITA_API_KEY}\\n      # Shared service-token for POST /v1/internal/usage. Forwarded\\n      # from the CVM .env file (written by Ansible from the host's\\n      # CLOUD_API_USAGE_TOKEN env var, in turn from the GH Actions\\n      # secret of the same name). When the .env doesn't define the\\n      # var, Docker Compose substitutes \\\"\\\" and cloud-api's config\\n      # layer coerces empty to None → endpoint stays disabled (503).\\n      - CLOUD_API_USAGE_TOKEN=${CLOUD_API_USAGE_TOKEN}\\n      - MODEL_DISCOVERY_REFRESH_INTERVAL=60\\n      - MODEL_DISCOVERY_TIMEOUT=5\\n      - LOG_LEVEL=info\\n      - LOG_FORMAT=json\\n      - RUST_LOG=info\\n      - RUST_BACKTRACE=1\\n      - LOG_MODULE_API=info\\n      - LOG_MODULE_SERVICES=info\\n      - DSTACK_CLIENT_URL=http://localhost:8000\\n      - AUTH_MOCK=false\\n      - GITHUB_CLIENT_ID=${GITHUB_CLIENT_ID}\\n      - GITHUB_CLIENT_SECRET=${GITHUB_CLIENT_SECRET}\\n      - GITHUB_REDIRECT_URL=https://cloud-api.near.ai/v1/auth/callback\\n      - GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}\\n      - GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET}\\n      - GOOGLE_REDIRECT_URL=https://cloud-api.near.ai/v1/auth/callback\\n      - NEAR_EXPECTED_RECIPIENT=${NEAR_EXPECTED_RECIPIENT}\\n      - AUTH_ADMIN_EMAILS=${AUTH_ADMIN_EMAILS}\\n      - AUTH_ADMIN_READ_ONLY_TOKENS_ENABLED=${AUTH_ADMIN_READ_ONLY_TOKENS_ENABLED:-false}\\n      - AUTH_REQUIRE_SESSION_BOUND_ACCESS_TOKENS=${AUTH_REQUIRE_SESSION_BOUND_ACCESS_TOKENS:-false}\\n      - DATABASE_NAME=${DATABASE_NAME}\\n      - DATABASE_USERNAME=${DATABASE_USERNAME}\\n      - DATABASE_TLS_ENABLED=true\\n      - DATABASE_PASSWORD_FILE=/config/postgres-password\\n      - AUTH_ENCODING_KEY=${AUTH_ENCODING_KEY}\\n      - S3_ENCRYPTION_KEYS=${S3_ENCRYPTION_KEYS:?}\\n      - OBJECT_ENCRYPTION_WRITE_ENABLED=${OBJECT_ENCRYPTION_WRITE_ENABLED:-true}\\n      - OBJECT_REWRAP_MAX_BYTES=${OBJECT_REWRAP_MAX_BYTES:-268435456}\\n      - DB_ENCRYPTION_KEYS=${DB_ENCRYPTION_KEYS:?}\\n      - DB_ENCRYPTION_WRITE_ENABLED=${DB_ENCRYPTION_WRITE_ENABLED:-false}\\n      - AWS_S3_BUCKET=${AWS_S3_BUCKET}\\n      - AWS_S3_REGION=${AWS_S3_REGION}\\n      - AWS_REGION=${AWS_S3_REGION}\\n      - AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}\\n      - AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}\\n      - BRAVE_SEARCH_PRO_API_KEY=${BRAVE_SEARCH_PRO_API_KEY}\\n      - BRAVE_LLM_CONTEXT_API_KEY=${BRAVE_LLM_CONTEXT_API_KEY}\\n      - GATEWAY_SUBDOMAIN=cvm3.near.ai\\n      - CORS_ALLOWED_ORIGINS=${CORS_ALLOWED_ORIGINS}\\n      - ENVIRONMENT=prod\\n      # Allocation order and version are persisted with each usage funding\\n      # split. Bump the version whenever the policy meaning changes.\\n      - CREDIT_USAGE_ORDER=${CREDIT_USAGE_ORDER:-grant,staking_farm,payment,postpay}\\n      - CREDIT_ALLOCATION_POLICY_VERSION=${CREDIT_ALLOCATION_POLICY_VERSION:-v1}\\n      # House of Stake farm credits (nearai/cloud-api#856). Shared template\\n      # passthroughs default hard-off so production remains disabled unless its\\n      # vars file explicitly opts in. Staging sets the contract/product IDs in\\n      # vars/cloud_api_stg.yaml.\\n      - STAKING_FARM_ENABLED=${STAKING_FARM_ENABLED:-false}\\n      - STAKING_FARM_SELECTED_ORG_BINDING_ENABLED=${STAKING_FARM_SELECTED_ORG_BINDING_ENABLED:-false}\\n      - NEAR_RPC_URL=${NEAR_RPC_URL:-https://free.rpc.fastnear.com}\\n      - NEAR_NETWORK_ID=${NEAR_NETWORK_ID:-mainnet}\\n      - NEAR_STAKING_CONTRACT_ID=${NEAR_STAKING_CONTRACT_ID:-}\\n      - STAKING_FARM_PRODUCT_ID=${STAKING_FARM_PRODUCT_ID:-}\\n      - STAKING_FARM_PRICE_ID=${STAKING_FARM_PRICE_ID:-}\\n      - STAKING_FARM_CREDIT_NANO_USD_PER_REWARD_UNIT=${STAKING_FARM_CREDIT_NANO_USD_PER_REWARD_UNIT:-1000000000}\\n      - STAKING_FARM_SYNC_STALENESS_SECONDS=${STAKING_FARM_SYNC_STALENESS_SECONDS:-300}\\n      # Lukka AML checks for NEAR wallet-gated House of Stake flows\\n      # (nearai/cloud-api#909). This template forwards cloud-api's AML-scoped\\n      # env names; the vars files reuse the same per-environment Lukka secrets\\n      # already used by chat-api.\\n      - LUKKA_AML_ENABLED=${LUKKA_AML_ENABLED:-false}\\n      - LUKKA_AML_BEARER_TOKEN=${LUKKA_AML_BEARER_TOKEN:-}\\n      - LUKKA_AML_BASE_URL=${LUKKA_AML_BASE_URL:-https://api.blockchain-analytics.lukka.tech}\\n      - LUKKA_AML_REPORT_REFRESH_DAYS=${LUKKA_AML_REPORT_REFRESH_DAYS:-30}\\n      - LUKKA_AML_MEMORY_CACHE_TTL_SECONDS=${LUKKA_AML_MEMORY_CACHE_TTL_SECONDS:-300}\\n      - LUKKA_AML_REQUEST_TIMEOUT_SECONDS=${LUKKA_AML_REQUEST_TIMEOUT_SECONDS:-10}\\n      - LUKKA_AML_BLOCKED_RISK_LEVELS=${LUKKA_AML_BLOCKED_RISK_LEVELS:-}\\n      - LUKKA_AML_SCORE_BLOCK_THRESHOLD=${LUKKA_AML_SCORE_BLOCK_THRESHOLD:-46}\\n      - LUKKA_AML_HIGH_RISK_SLACK_WEBHOOK_URL=${LUKKA_AML_HIGH_RISK_SLACK_WEBHOOK_URL:-}\\n      - LUKKA_AML_HIGH_RISK_SLACK_TIMEOUT_MS=${LUKKA_AML_HIGH_RISK_SLACK_TIMEOUT_MS:-3000}\\n      - TELEMETRY_SERVICE_NAME=cloud-api\\n      - TELEMETRY_OTLP_ENDPOINT=http://otelcol-contrib:4317\\n      - GEMINI_API_KEY=${GEMINI_API_KEY}\\n      - OPENAI_API_KEY=${OPENAI_API_KEY}\\n      - ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}\\n      - TYPESAFE_API_KEY=${TYPESAFE_API_KEY:-}\\n      # Canonical model IDs eligible for native stateless Responses. Empty disables routing.\\n      - NATIVE_RESPONSES_MODELS=${NATIVE_RESPONSES_MODELS:-}\\n      # Native Anthropic Messages endpoints. Included only when an environment\\n      # explicitly opts in; production renders no setting and remains hard-off.\\n      - ENABLE_ANTHROPIC_MESSAGES=${ENABLE_ANTHROPIC_MESSAGES:-false}\\n      # Extra anthropic-beta tokens admitted by the native Messages routes on\\n      # top of the image's built-in allowlist. Rendered only when set.\\n      - ANTHROPIC_ALLOWED_BETAS=${ANTHROPIC_ALLOWED_BETAS:-}\\n      - EXTERNAL_PROVIDER_TIMEOUT=${EXTERNAL_PROVIDER_TIMEOUT}\\n      - INVITATION_EMAIL_ENABLED=${INVITATION_EMAIL_ENABLED}\\n      - CONTACT_EMAIL_VERIFICATION_ENABLED=${CONTACT_EMAIL_VERIFICATION_ENABLED:-false}\\n      - INVITATION_EMAIL_FROM=${INVITATION_EMAIL_FROM}\\n      - RESEND_API_KEY=${RESEND_API_KEY}\\n      - CLOUD_UI_BASE_URL=${CLOUD_UI_BASE_URL}\\n      # Chutes attested third-party provider (nearai/cloud-api#758). Forwarded\\n      # from the CVM .env (set only where the vars file defines them — staging\\n      # for now). Missing → Compose substitutes the defaults below → cloud-api\\n      # keeps Chutes hard-off (ENABLE_CHUTES != \\\"true\\\"/\\\"1\\\"; empty key → None —\\n      # cloud-api config filters `CHUTES_API_KEY=\\\"\\\"` to absent via\\n      # `.filter(|s| !s.is_empty())`, so it fails closed (provider not registered);\\n      # empty CHUTES_MODELS → no models). So this passthrough is a no-op for\\n      # prod until its vars file opts in. CHUTES_ENABLE_STREAMING defaults off;\\n      # opt in per-environment via the vars file (see vars/cloud_api_stg.yaml for\\n      # the streaming-safety analysis). PCCS is intentionally omitted (unset →\\n      # dcap-qvl default collateral).\\n      # AUDIT NOTE: this template is shared with prod (vars/cloud_api_prod.yaml).\\n      # Adding these four passthroughs changes prod's rendered compose and thus its\\n      # KMS-registered attestation measurement; the daily 02:00 UTC\\n      # update_cloud_api_prod.yml cron re-registers it (idempotent add-hash with an\\n      # on-chain pre-check) within ~24h. Behaviorally a no-op for prod — the `:-`\\n      # defaults resolve Chutes hard-off — but the measurement digest does change.\\n      - ENABLE_CHUTES=${ENABLE_CHUTES:-false}\\n      - CHUTES_ENABLE_STREAMING=${CHUTES_ENABLE_STREAMING:-false}\\n      - CHUTES_MODELS=${CHUTES_MODELS:-}\\n      - CHUTES_API_KEY=${CHUTES_API_KEY:-}\\n      # Tinfoil attested fallback provider (nearai/cloud-api#1213). Empty defaults\\n      # keep Tinfoil off (empty models register nothing; empty key is absent).\\n      - TINFOIL_MODELS=${TINFOIL_MODELS:-}\\n      - TINFOIL_API_KEY=${TINFOIL_API_KEY:-}\\n      # OHTTP gateway (RFC 9458). Off by default; opt in per-environment\\n      # via env_vars (vars/cloud_api_stg.yaml sets OHTTP_ENABLED=true).\\n      - OHTTP_ENABLED=${OHTTP_ENABLED:-false}\\n      # Smart-placement replica state (cloud-api reads signed state from the\\n      # shared Valkey). Values come from the CVM .env written from the\\n      # environment-specific vars file. An empty PLACEMENT_REDIS_HOST (or\\n      # password) leaves placement off with legacy routing, and the TLS CA may be\\n      # a one-line PEM with literal \\\\n escapes. Rendered only where the vars file\\n      # defines PLACEMENT_REDIS_HOST, so prod stays dark until it opts in.\\n      # AUDIT NOTE: this template is shared with prod; the guard keeps prod's\\n      # rendered compose, and so its KMS measurement, unchanged.\\n      - PLACEMENT_REDIS_HOST=${PLACEMENT_REDIS_HOST:-}\\n      - PLACEMENT_REDIS_PORT=${PLACEMENT_REDIS_PORT:-6379}\\n      - PLACEMENT_REDIS_TLS_ENABLED=${PLACEMENT_REDIS_TLS_ENABLED:-true}\\n      - PLACEMENT_REDIS_TLS_CA_CERT=${PLACEMENT_REDIS_TLS_CA_CERT:-}\\n      - PLACEMENT_REDIS_PASSWORD=${PLACEMENT_REDIS_PASSWORD:-}\\n      - TLS_CERT_PATH=/ingress-certs/cloud-api.near.ai/fullchain.pem\\n    dns:\\n      - 1.1.1.1\\n    ports:\\n      - \\\"3000:3000\\\"\\n    depends_on:\\n      api-init:\\n        condition: service_completed_successfully\\n      ingress:\\n        condition: service_healthy\\n    healthcheck:\\n      test:\\n        [\\\"CMD-SHELL\\\", \\\"curl -f http://127.0.0.1:3000/v1/model/list || exit 1\\\"]\\n      interval: 30s\\n      timeout: 3s\\n      retries: 10\\n      start_period: 40s\\n    labels:\\n      com.datadoghq.ad.logs: '[{\\\"source\\\": \\\"cloud-api\\\", \\\"service\\\": \\\"cloud-api\\\"}]'\\n    logging:\\n      driver: \\\"json-file\\\"\\n      options:\\n        max-size: \\\"100m\\\"\\n        max-file: \\\"10\\\"\\n        labels: \\\"com.datadoghq.ad.logs,com.docker.compose.service\\\"\\n\\n\\n  # Ingress sidecar: nginx reverse proxy (TLS optional)\\n  ingress:\\n    container_name: ingress\\n    image: nearaidev/cvm-ingress@sha256:83c456476bc88c4f7b59fdc1afc8760606d736268038d3439cf1a37e707d7dc7\\n    restart: unless-stopped\\n    environment:\\n      - DOMAIN=cloud-api.near.ai\\n      - BACKEND_HOST=cloud-api\\n      - BACKEND_PORT=3000\\n      - TLS_ENABLED=true\\n      - CERTBOT_EMAIL=${CERTBOT_EMAIL}\\n      - CLOUDFLARE_API_TOKEN=${CLOUDFLARE_API_TOKEN}\\n      - S3_BUCKET=${INGRESS_S3_BUCKET}\\n      - S3_PREFIX=cloud-api-prod\\n      - AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}\\n      - AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}\\n      - AWS_DEFAULT_REGION=${AWS_DEFAULT_REGION}\\n      - STAGING=false\\n    volumes:\\n      - /var/run/dstack.sock:/var/run/dstack.sock\\n      - ingress_certs:/certs\\n    ports:\\n      - \\\"8443:8443\\\"\\n    healthcheck:\\n      test: [\\\"CMD-SHELL\\\", \\\"test -f /certs/cloud-api.near.ai/fullchain.pem\\\"]\\n      interval: 5s\\n      timeout: 3s\\n      retries: 60\\n      start_period: 10s\\n    labels:\\n      com.datadoghq.ad.logs: '[{\\\"source\\\": \\\"nginx\\\", \\\"service\\\": \\\"ingress\\\", \\\"tags\\\": [\\\"role:ingress\\\", \\\"deployment:cloud-api-prod\\\", \\\"env:${ENV}\\\", \\\"host:${CVM_HOST}\\\", \\\"ip:${HOST_IP}\\\", \\\"port:8443\\\", \\\"domain:cloud-api.near.ai\\\"]}]'\\n    logging:\\n      driver: \\\"json-file\\\"\\n      options:\\n        max-size: \\\"100m\\\"\\n        max-file: \\\"10\\\"\\n        labels: \\\"com.datadoghq.ad.logs,com.docker.compose.service\\\"\\n\\n\\nvolumes:\\n  otelcol-storage:\\n  otelcol-identity:\\n\\n  api_config:\\n  ingress_certs:\\nconfigs:\\n  \\n  # otelcol-contrib config for guest-level CVM telemetry. Dollar signs are\\n# escaped as $$ so docker compose leaves OTel's ${env:...} references intact.\\n  otelcol_cvm_config:\\n    content: |\\n      receivers:\\n        otlp:\\n          protocols:\\n            grpc:\\n              endpoint: 0.0.0.0:4317\\n            http:\\n              endpoint: 0.0.0.0:4318\\n\\n        filelog/docker_containers:\\n          include: [/var/lib/docker/containers/*/*-json.log]\\n          start_at: end\\n          storage: file_storage\\n          include_file_path: true\\n          operators:\\n            - type: json_parser\\n              parse_from: body\\n              parse_to: attributes\\n              timestamp:\\n                parse_from: attributes.time\\n                layout_type: gotime\\n                layout: '2006-01-02T15:04:05.999999999Z07:00'\\n              on_error: send_quiet\\n            - type: move\\n              from: attributes.log\\n              to: body\\n              if: 'attributes.log != nil'\\n            - type: move\\n              from: attributes.stream\\n              to: attributes[\\\"log.iostream\\\"]\\n              if: 'attributes.stream != nil'\\n            - type: remove\\n              field: attributes.time\\n              if: 'attributes.time != nil'\\n            - type: regex_parser\\n              parse_from: attributes[\\\"log.file.path\\\"]\\n              regex: '/var/lib/docker/containers/(?P<container_id>[a-f0-9]{12})[a-f0-9]*/'\\n              on_error: send_quiet\\n            # Preserve the low-cardinality Datadog autodiscovery tags operators\\n            # already use as log filters. High-cardinality tags like instance\\n            # and model_path stay inside the raw Docker label metadata.\\n            - type: regex_parser\\n              parse_from: attributes[\\\"attrs\\\"][\\\"com.datadoghq.ad.logs\\\"]\\n              regex: 'model:(?P<model>[^\\\",\\\\]]+)'\\n              on_error: send_quiet\\n            - type: regex_parser\\n              parse_from: attributes[\\\"attrs\\\"][\\\"com.datadoghq.ad.logs\\\"]\\n              regex: 'deployment:(?P<deployment>[^\\\",\\\\]]+)'\\n              on_error: send_quiet\\n            - type: regex_parser\\n              parse_from: attributes[\\\"attrs\\\"][\\\"com.datadoghq.ad.logs\\\"]\\n              regex: 'ip:(?P<ip>[^\\\",\\\\]]+)'\\n              on_error: send_quiet\\n            - type: regex_parser\\n              parse_from: attributes[\\\"attrs\\\"][\\\"com.datadoghq.ad.logs\\\"]\\n              regex: 'port:(?P<port>[^\\\",\\\\]]+)'\\n              on_error: send_quiet\\n            - type: regex_parser\\n              parse_from: attributes[\\\"attrs\\\"][\\\"com.datadoghq.ad.logs\\\"]\\n              regex: 'env:(?P<env>[^\\\",\\\\]]+)'\\n              on_error: send_quiet\\n            - type: regex_parser\\n              parse_from: attributes[\\\"attrs\\\"][\\\"com.datadoghq.ad.logs\\\"]\\n              regex: 'host:(?P<host>[^\\\",\\\\]]+)'\\n              on_error: send_quiet\\n            - type: add\\n              field: attributes[\\\"service.name\\\"]\\n              value: cvm-docker\\n\\n        hostmetrics/cvm:\\n          collection_interval: 30s\\n          root_path: $${env:CVM_HOSTMETRICS_ROOT_PATH}\\n          scrapers:\\n            cpu: {}\\n            memory: {}\\n            load: {}\\n            paging: {}\\n            network: {}\\n            disk: {}\\n            filesystem:\\n              exclude_mount_points:\\n                mount_points: [\\\"^/dev(/.*)?$\\\", \\\"^/proc(/.*)?$\\\", \\\"^/sys(/.*)?$\\\", \\\"^/run(/.*)?$\\\", \\\"^/var/lib/docker(/.*)?$\\\"]\\n                match_type: regexp\\n\\n        docker_stats/cvm:\\n          endpoint: unix:///var/run/docker.sock\\n          collection_interval: 30s\\n          timeout: 10s\\n          api_version: \\\"1.44\\\"\\n          container_labels_to_metric_labels:\\n            com.docker.compose.service: compose_service\\n            com.docker.compose.project: compose_project\\n\\n        prometheus/self:\\n          config:\\n            scrape_configs:\\n              - job_name: otelcol-cvm\\n                scrape_interval: 30s\\n                static_configs:\\n                  - targets: ['localhost:8888']\\n              - job_name: docker-labeled-services\\n                scrape_interval: 15s\\n                docker_sd_configs:\\n                  - host: unix:///var/run/docker.sock\\n                    refresh_interval: 30s\\n                relabel_configs:\\n                  - source_labels: [__meta_docker_container_label_nearai_otel_scrape]\\n                    regex: \\\"true\\\"\\n                    action: keep\\n                  - source_labels: [__meta_docker_network_name]\\n                    regex: dstack_default\\n                    action: keep\\n                  - source_labels: [__meta_docker_container_label_nearai_otel_port]\\n                    regex: \\\".+\\\"\\n                    action: keep\\n                  - source_labels: [__meta_docker_network_ip, __meta_docker_container_label_nearai_otel_port]\\n                    separator: \\\":\\\"\\n                    target_label: __address__\\n                    replacement: \\\"$$1:$$2\\\"\\n                  - source_labels: [__meta_docker_container_label_nearai_otel_path]\\n                    regex: \\\"(.+)\\\"\\n                    target_label: __metrics_path__\\n                  - source_labels: [__meta_docker_container_label_nearai_otel_job]\\n                    regex: \\\"(.+)\\\"\\n                    target_label: job\\n                  - source_labels: [__meta_docker_container_label_nearai_otel_service]\\n                    regex: \\\"(.+)\\\"\\n                    target_label: service\\n                  - source_labels: [__meta_docker_container_label_com_docker_compose_service]\\n                    regex: \\\"(.+)\\\"\\n                    target_label: container_name\\n                  - source_labels: [__meta_docker_container_label_nearai_otel_model]\\n                    regex: \\\"(.+)\\\"\\n                    target_label: model\\n                  - source_labels: [__meta_docker_container_label_nearai_otel_deployment]\\n                    regex: \\\"(.+)\\\"\\n                    target_label: deployment\\n                  - source_labels: [__meta_docker_container_label_nearai_otel_env]\\n                    regex: \\\"(.+)\\\"\\n                    target_label: env\\n                  - source_labels: [__meta_docker_container_label_nearai_otel_host]\\n                    regex: \\\"(.+)\\\"\\n                    target_label: host\\n                  - source_labels: [__meta_docker_container_label_nearai_otel_ip]\\n                    regex: \\\"(.+)\\\"\\n                    target_label: ip\\n                  - source_labels: [__meta_docker_container_label_nearai_otel_port]\\n                    regex: \\\"(.+)\\\"\\n                    target_label: port\\n              \\n        \\n\\n      processors:\\n        memory_limiter:\\n          check_interval: 1s\\n          limit_mib: 256\\n          spike_limit_mib: 64\\n\\n        resource:\\n          attributes:\\n            - key: host.name\\n              value: $${env:DD_HOSTNAME}\\n              action: upsert\\n            - key: cvm.name\\n              value: $${env:CVM_NAME}\\n              action: upsert\\n            - key: host.machine\\n              value: $${env:CVM_HOST}\\n              action: insert\\n            - key: deployment.environment\\n              value: $${env:ENV}\\n              action: upsert\\n            - key: service.namespace\\n              value: near-ai\\n              action: insert\\n\\n        \\n        resource/cvm_instance:\\n          attributes:\\n            - key: cvm.instance.id\\n              value: $${file:/telemetry/instance_id}\\n              action: upsert\\n\\n        # dstack-vpc-client writes instance_id with echo, so strip its trailing\\n        # newline before Prometheus converts cvm.instance.id to cvm_instance_id.\\n        transform/cvm_instance:\\n          error_mode: propagate\\n          metric_statements:\\n            - replace_pattern(resource.attributes[\\\"cvm.instance.id\\\"], \\\"\\\\\\\\s+$\\\", \\\"\\\")\\n            - delete_key(resource.attributes, \\\"cvm.instance.id\\\") where resource.attributes[\\\"cvm.instance.id\\\"] == \\\"unavailable\\\"\\n          log_statements:\\n            - context: resource\\n              statements:\\n                - replace_pattern(attributes[\\\"cvm.instance.id\\\"], \\\"\\\\\\\\s+$\\\", \\\"\\\")\\n                - delete_key(attributes, \\\"cvm.instance.id\\\") where attributes[\\\"cvm.instance.id\\\"] == \\\"unavailable\\\"\\n          trace_statements:\\n            - context: resource\\n              statements:\\n                - replace_pattern(attributes[\\\"cvm.instance.id\\\"], \\\"\\\\\\\\s+$\\\", \\\"\\\")\\n                - delete_key(attributes, \\\"cvm.instance.id\\\") where attributes[\\\"cvm.instance.id\\\"] == \\\"unavailable\\\"\\n        \\n\\n        transform/docker_metadata:\\n          error_mode: ignore\\n          log_statements:\\n            - context: log\\n              statements:\\n                - set(attributes[\\\"service.name\\\"], attributes[\\\"attrs\\\"][\\\"com.docker.compose.service\\\"]) where attributes[\\\"attrs\\\"] != nil and attributes[\\\"attrs\\\"][\\\"com.docker.compose.service\\\"] != nil\\n                - set(attributes[\\\"service.name\\\"], ParseJSON(attributes[\\\"attrs\\\"][\\\"com.datadoghq.ad.logs\\\"])[0][\\\"service\\\"]) where attributes[\\\"attrs\\\"] != nil and attributes[\\\"attrs\\\"][\\\"com.datadoghq.ad.logs\\\"] != nil\\n                - set(attributes[\\\"log.source\\\"], ParseJSON(attributes[\\\"attrs\\\"][\\\"com.datadoghq.ad.logs\\\"])[0][\\\"source\\\"]) where attributes[\\\"attrs\\\"] != nil and attributes[\\\"attrs\\\"][\\\"com.datadoghq.ad.logs\\\"] != nil\\n                - set(attributes[\\\"container.name\\\"], attributes[\\\"attrs\\\"][\\\"com.docker.compose.service\\\"]) where attributes[\\\"attrs\\\"] != nil and attributes[\\\"attrs\\\"][\\\"com.docker.compose.service\\\"] != nil\\n\\n        groupbyattrs/docker_service:\\n          keys:\\n            - service.name\\n            - container.name\\n            - log.source\\n            - log.iostream\\n            - model\\n            - deployment\\n            - env\\n            - host\\n            - ip\\n            - port\\n\\n        batch:\\n          send_batch_size: 1024\\n          send_batch_max_size: 2048\\n          timeout: 5s\\n\\n      exporters:\\n        otlphttp/gateway:\\n          endpoint: https://telemetry.infra.near.ai\\n          headers:\\n            Authorization: \\\"Bearer $${env:MONITORING_INGEST_TOKEN}\\\"\\n          # Keep source requests FIFO. The Collector default is ten queue\\n          # consumers; once they reorder cumulative samples, the gateway's\\n          # serialized remote-write queue cannot restore their order.\\n          sending_queue:\\n            num_consumers: 1\\n            queue_size: 128\\n            storage: file_storage\\n        \\n\\n      extensions:\\n        file_storage:\\n          directory: /var/lib/otelcol-contrib/storage\\n          create_directory: true\\n\\n      service:\\n        extensions: [file_storage]\\n        pipelines:\\n          logs/cvm:\\n            receivers: [filelog/docker_containers]\\n            processors: [memory_limiter, resource, resource/cvm_instance, transform/cvm_instance, transform/docker_metadata, groupbyattrs/docker_service, batch]\\n            exporters: [otlphttp/gateway]\\n          metrics/cvm_system:\\n            receivers: [hostmetrics/cvm, docker_stats/cvm]\\n            processors: [memory_limiter, resource, resource/cvm_instance, transform/cvm_instance, batch]\\n            exporters: [otlphttp/gateway]\\n          logs/otlp:\\n            receivers: [otlp]\\n            processors: [memory_limiter, resource, resource/cvm_instance, transform/cvm_instance, batch]\\n            exporters: [otlphttp/gateway]\\n          metrics/self:\\n            receivers: [prometheus/self]\\n            processors: [memory_limiter, resource, resource/cvm_instance, transform/cvm_instance, batch]\\n            exporters: [otlphttp/gateway]\\n          \\n          metrics/otlp:\\n            receivers: [otlp]\\n            processors: [memory_limiter, resource, resource/cvm_instance, transform/cvm_instance, batch]\\n            exporters: [otlphttp/gateway]\\n          traces:\\n            receivers: [otlp]\\n            processors: [memory_limiter, resource, resource/cvm_instance, transform/cvm_instance, batch]\\n            exporters: [otlphttp/gateway]\\n        telemetry:\\n          metrics:\\n            address: localhost:8888\\n          logs:\\n            level: info\\n\\n\\n  api_init_script:\\n    content: |\\n      #!/bin/sh\\n      set -e\\n\\n      echo \\\"Cloud API initialization starting...\\\"\\n\\n      # No instance identity source is available; the collector drops this\\n      # sentinel from metric resources.\\n      umask 077\\n      printf 'unavailable' > /telemetry/instance_id\\n      chmod 0444 /telemetry/instance_id\\n\\n      # Decode only inside the CVM; never place raw credentials in Compose.\\n      # RDS material is independent of the unchanged VPC-derived encryption keys.\\n      umask 077\\n      if ! printf '%s' \\\"$${CLOUD_API_RDS_PASSWORD_B64:?}\\\" | base64 -d > /config/postgres-password; then\\n        echo \\\"Invalid RDS password encoding\\\" >&2\\n        exit 1\\n      fi\\n      if ! printf '%s' \\\"$${CLOUD_API_RDS_CA_BUNDLE_B64:?}\\\" | base64 -d > /config/rds-ca-bundle.pem; then\\n        echo \\\"Invalid RDS CA bundle encoding\\\" >&2\\n        exit 1\\n      fi\\n      test -s /config/postgres-password\\n      test -s /config/rds-ca-bundle.pem\\n      chown 1000:1000 /config/postgres-password /config/rds-ca-bundle.pem\\n      chmod 600 /config/postgres-password /config/rds-ca-bundle.pem\\n      unset CLOUD_API_RDS_PASSWORD_B64 CLOUD_API_RDS_CA_BUNDLE_B64\\n\\n\\n      echo \\\"Initialization complete\\\"\\n\\n\",\"kms_enabled\":true,\"gateway_enabled\":true,\"local_key_provider_enabled\":false,\"key_provider_id\":\"\",\"public_logs\":false,\"public_sysinfo\":true,\"allowed_envs\":[\"DATABASE_NAME\",\"DATABASE_USERNAME\",\"CLOUD_API_RDS_PASSWORD_B64\",\"CLOUD_API_RDS_CA_BUNDLE_B64\",\"MODEL_DISCOVERY_SERVER_URL\",\"MODEL_DISCOVERY_API_KEY\",\"INFRA_PROMETHEUS_URL\",\"INFRA_PROMETHEUS_BEARER_TOKEN\",\"INFRA_PROMETHEUS_ENV\",\"INFRA_COST_PER_GPU_HOUR_USD\",\"INFERENCE_API_KEY\",\"CLOUD_API_USAGE_TOKEN\",\"AUTH_ENCODING_KEY\",\"DB_ENCRYPTION_WRITE_ENABLED\",\"GITHUB_CLIENT_ID\",\"GITHUB_CLIENT_SECRET\",\"GOOGLE_CLIENT_ID\",\"GOOGLE_CLIENT_SECRET\",\"AUTH_ADMIN_EMAILS\",\"AUTH_ADMIN_READ_ONLY_TOKENS_ENABLED\",\"AWS_S3_BUCKET\",\"AWS_S3_REGION\",\"AWS_REGION\",\"AWS_ACCESS_KEY_ID\",\"AWS_SECRET_ACCESS_KEY\",\"BRAVE_SEARCH_PRO_API_KEY\",\"BRAVE_LLM_CONTEXT_API_KEY\",\"CORS_ALLOWED_ORIGINS\",\"NEAR_EXPECTED_RECIPIENT\",\"NEAR_RPC_URL\",\"NEAR_NETWORK_ID\",\"CREDIT_USAGE_ORDER\",\"CREDIT_ALLOCATION_POLICY_VERSION\",\"STAKING_FARM_ENABLED\",\"STAKING_FARM_SELECTED_ORG_BINDING_ENABLED\",\"NEAR_STAKING_CONTRACT_ID\",\"STAKING_FARM_PRODUCT_ID\",\"STAKING_FARM_PRICE_ID\",\"STAKING_FARM_CREDIT_NANO_USD_PER_REWARD_UNIT\",\"STAKING_FARM_SYNC_STALENESS_SECONDS\",\"LUKKA_AML_ENABLED\",\"LUKKA_AML_BEARER_TOKEN\",\"LUKKA_AML_BASE_URL\",\"LUKKA_AML_REPORT_REFRESH_DAYS\",\"LUKKA_AML_MEMORY_CACHE_TTL_SECONDS\",\"LUKKA_AML_REQUEST_TIMEOUT_SECONDS\",\"LUKKA_AML_BLOCKED_RISK_LEVELS\",\"LUKKA_AML_SCORE_BLOCK_THRESHOLD\",\"LUKKA_AML_HIGH_RISK_SLACK_WEBHOOK_URL\",\"LUKKA_AML_HIGH_RISK_SLACK_TIMEOUT_MS\",\"GEMINI_API_KEY\",\"OPENAI_API_KEY\",\"ANTHROPIC_API_KEY\",\"TYPESAFE_API_KEY\",\"NATIVE_RESPONSES_MODELS\",\"ENABLE_ANTHROPIC_MESSAGES\",\"ANTHROPIC_ALLOWED_BETAS\",\"EXTERNAL_PROVIDER_TIMEOUT\",\"CERTBOT_EMAIL\",\"CLOUDFLARE_API_TOKEN\",\"INGRESS_S3_BUCKET\",\"AWS_DEFAULT_REGION\",\"INVITATION_EMAIL_ENABLED\",\"CONTACT_EMAIL_VERIFICATION_ENABLED\",\"INVITATION_EMAIL_FROM\",\"RESEND_API_KEY\",\"CLOUD_UI_BASE_URL\",\"ITA_API_KEY\",\"ENABLE_CHUTES\",\"CHUTES_ENABLE_STREAMING\",\"CHUTES_MODELS\",\"CHUTES_API_KEY\",\"TINFOIL_MODELS\",\"TINFOIL_API_KEY\",\"OHTTP_ENABLED\",\"PLACEMENT_REDIS_HOST\",\"PLACEMENT_REDIS_PORT\",\"PLACEMENT_REDIS_TLS_ENABLED\",\"PLACEMENT_REDIS_TLS_CA_CERT\",\"PLACEMENT_REDIS_PASSWORD\",\"DB_ENCRYPTION_KEYS\",\"S3_ENCRYPTION_KEYS\",\"OBJECT_ENCRYPTION_WRITE_ENABLED\",\"OBJECT_REWRAP_MAX_BYTES\",\"DD_API_KEY\",\"HUGGING_FACE_HUB_TOKEN\",\"PROXY_TOKEN\",\"ENV\",\"HOST_IP\",\"DD_HOSTNAME\",\"MONITORING_INGEST_TOKEN\",\"CVM_NAME\",\"CVM_HOST\"],\"no_instance_id\":false,\"secure_time\":false,\"port_policy\":{\"restrict_mode\":true,\"ports\":[{\"port\":443,\"pp\":false}]}}\n","event_log":[{"imr":0,"event_type":2147483659,"digest":"2e070cda358b5aa00f27cca25c47381bb564f4be3a84d059805a73cbbde764ed8341f7e09915b5e7b370f9c08a743fbd","event":"","event_payload":"095464785461626c65000100000000000000af96bb93f2b9b84e9462e0ba745642360090800000000000"},{"imr":0,"event_type":2147483658,"digest":"344bc51c980ba621aaa00da3ed7436f7d6e549197dfe699515dfa2c6583d95e6412af21c097d473155875ffd561d6790","event":"","event_payload":"2946762858585858585858582d585858582d585858582d585858582d58585858585858585858585829000000c0ff000000000040080000000000"},{"imr":0,"event_type":2147483649,"digest":"9dc3a1f80bcec915391dcda5ffbb15e7419f77eab462bbf72b42166fb70d50325e37b36f93537a863769bcf9bedae6fb","event":"","event_payload":"61dfe48bca93d211aa0d00e098032b8c0a00000000000000000000000000000053006500630075007200650042006f006f007400"},{"imr":0,"event_type":2147483649,"digest":"6f2e3cbc14f9def86980f5f66fd85e99d63e69a73014ed8a5633ce56eca5b64b692108c56110e22acadcef58c3250f1b","event":"","event_payload":"61dfe48bca93d211aa0d00e098032b8c0200000000000000000000000000000050004b00"},{"imr":0,"event_type":2147483649,"digest":"d607c0efb41c0d757d69bca0615c3a9ac0b1db06c557d992e906c6b7dee40e0e031640c7bfd7bcd35844ef9edeadc6f9","event":"","event_payload":"61dfe48bca93d211aa0d00e098032b8c030000000000000000000000000000004b0045004b00"},{"imr":0,"event_type":2147483649,"digest":"08a74f8963b337acb6c93682f934496373679dd26af1089cb4eaf0c30cf260a12e814856385ab8843e56a9acea19e127","event":"","event_payload":"cbb219d73a3d9645a3bcdad00e67656f0200000000000000000000000000000064006200"},{"imr":0,"event_type":2147483649