Q5vZAwCgYIKoZIzj0EAwIw\nKTEPMA0GA1UECgwGZHN0YWNrMRYwFAYDVQQDDA1kc3RhY2sgS01TIENBMB4XDTc1\nMDEwMTAwMDAwMFoXDTM1MTAxNDA0MTIyM1owKTEPMA0GA1UECgwGZHN0YWNrMRYw\nFAYDVQQDDA1kc3RhY2sgS01TIENBMFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAE\nIo+ABZChBELLqdDmrbL6nxle6p514j3TWZDVK1ndokFaY2dMOK3r3k/9TUsmW/gY\nmFkzggyAU87jzim1+w+8vKNGMEQwDwYDVR0PAQH/BAUDAweGADAdBgNVHQ4EFgQU\nPSTxEnC0eBDGc3vsKYCnz3UaKzowEgYDVR0TAQH/BAgwBgEB/wIBATAKBggqhkjO\nPQQDAgNHADBEAiAajnZ9dcqsggH6QugOxyXM0lX7LpBtTymEIqi45d5mpwIgQa7K\niYvCXVIc36PWLub/wWbWoaCKgrFF5H3isr6Sv/Q=\n-----END CERTIFICATE-----\n","tcb_info":{"mrtd":"f06dfda6dce1cf904d4e2bab1dc370634cf95cefa2ceb2de2eee127c9382698090d7a4a13e14c536ec6c9c3c8fa87077","rtmr0":"fb14dc139f33d6fcf474bc8332cac001259fb31cfbcb6b34d4ceeb552a2c4466884a0cbde45ad98a05c5c060c23ad65a","rtmr1":"a7b523278d4f914ee8df0ec80cd1c3d498cbf1152b0c5eaf65bad9425072874a3fcf891e8b01713d3d9937e3e0d26c15","rtmr2":"24847f5c5a2360d030bc4f7b8577ce32e87c4d051452c937e91220cab69542daef83433947c492b9c201182fc9769bbe","rtmr3":"15c99793caec9be27b7b1c5945859ce8307efeb43c4b9fa204f6959269a8888bf1da36284eed2f33d6c38185b4f702ea","os_image_hash":"da9a3d5cc196a1a76d953fb27069be428ddf60a1ce10b0534c3cf968d3053fde","compose_hash":"250d96d8aef40571949f9a4f9d09ac8d6433e25978f8b0abd0bd53825119b56e","device_id":"388d26036ff4e67fa9e50d05ed4f24ac742b13767e3103c235f48fc74126d9e9","app_compose":"{\n    \"manifest_version\": 2,\n    \"name\": \"dstack-0.5.4\",\n    \"runner\": \"docker-compose\",\n    \"docker_compose_file\": \"# Docker Compose configuration for Cloud API in a VPC environment\\n# This setup includes the dstack-service for VPC management and an init container\\n# to prepare necessary configuration files before starting the Cloud API service.\\n\\nservices:\\n  # Datadog Service Definition\\n  datadog-agent:\\n    image: datadog/agent@sha256:5556fb80b952832719a76b016f905616c76ee0989a239c4680c6220148e865d6\\n    container_name: datadog-agent\\n    environment:\\n      - DD_API_KEY=${DD_API_KEY}\\n      - DD_SITE=us3.datadoghq.com\\n      - DD_ENV=prod\\n      - DD_LOGS_ENABLED=true\\n      - DD_OTLP_CONFIG_LOGS_ENABLED=true\\n      - DD_LOGS_CONFIG_CONTAINER_COLLECT_ALL=true\\n      - DD_CONTAINER_EXCLUDE_LOGS=name:datadog-agent\\n      - DD_PROCESS_AGENT_ENABLED=true\\n      - DD_DOGSTATSD_NON_LOCAL_TRAFFIC=true\\n      - DD_HOSTNAME=$DD_HOSTNAME\\n      # Datadog Agent 7.61+ can fail to start its OTLP receiver in Docker\\n      # when it tries to collect process metrics through /host/proc.\\n      - HOST_PROC=/proc\\n      - DD_OTLP_CONFIG_RECEIVER_PROTOCOLS_GRPC_ENDPOINT=0.0.0.0:4317\\n    volumes:\\n      - /var/run/docker.sock:/var/run/docker.sock:ro\\n      - /proc/:/host/proc/:ro\\n      - /sys/fs/cgroup/:/host/sys/fs/cgroup:ro\\n      - /var/lib/docker/containers:/var/lib/docker/containers:ro\\n      - /run/log/journal:/run/log/journal:ro\\n      - /run/systemd/:/host/run/systemd/:ro\\n    configs:\\n      - source: journald_config_file\\n        target: /etc/datadog-agent/conf.d/journald.d/conf.yaml\\n        mode: 0755\\n    restart: unless-stopped\\n    logging:\\n      driver: \\\"local\\\"\\n      options:\\n        max-size: \\\"20m\\\"\\n        max-file: \\\"3\\\"\\n\\n  # OpenTelemetry collector sidecar for in-CVM logs/metrics/traces.\\n  otelcol-contrib:\\n    image: otel/opentelemetry-collector-contrib@sha256:85ac41c2db88d0df9bd6145e608a3cb023f5d8443868adbfbbf66efb51087917\\n    container_name: otelcol-contrib\\n    command: [\\\"--config=/etc/otelcol-contrib/config.yaml\\\"]\\n    user: \\\"0:0\\\"\\n    mem_limit: \\\"512m\\\"\\n    environment:\\n      - MONITORING_INGEST_TOKEN=${MONITORING_INGEST_TOKEN}\\n      - CVM_NAME=${CVM_NAME}\\n      - CVM_HOST=${CVM_HOST}\\n      - DD_HOSTNAME=${DD_HOSTNAME}\\n      - ENV=${ENV}\\n      - CVM_HOSTMETRICS_ROOT_PATH=/hostfs\\n      \\n    expose:\\n      - \\\"4317\\\"\\n      - \\\"4318\\\"\\n    volumes:\\n      # Required for Prometheus docker_sd_configs. The scrape rules below only\\n      # keep containers explicitly labeled nearai.otel.scrape=true.\\n      - /var/run/docker.sock:/var/run/docker.sock:ro\\n      # Required for CVM guest hostmetrics parity. OTel prefixes host mount\\n      # points with root_path=/hostfs so the collector reports the guest host,\\n      # not the collector container filesystem.\\n      - /:/hostfs:ro\\n      - /var/lib/docker/containers:/var/lib/docker/containers:ro\\n      \\n      - otelcol-identity:/telemetry:ro\\n      \\n      - otelcol-storage:/var/lib/otelcol-contrib\\n    configs:\\n      - source: otelcol_cvm_config\\n        target: /etc/otelcol-contrib/config.yaml\\n        mode: 0444\\n    \\n    # Datadog and identity-enabled CVMs declare their startup prerequisites\\n    # through cvm_telemetry_depends_on_config.\\n    depends_on:\\n        datadog-agent:\\n          condition: service_started\\n        api-init:\\n          condition: service_completed_successfully\\n\\n    \\n    restart: unless-stopped\\n    # Avoid the collector tailing its own Docker JSON log and creating a\\n    # feedback loop. The host-side Phase 1 collector still captures VM\\n    # serial/stderr if this sidecar itself needs debugging.\\n    logging:\\n      driver: \\\"local\\\"\\n      options:\\n        max-size: \\\"20m\\\"\\n        max-file: \\\"3\\\"\\n\\n\\n  # VPC Services Definition\\n  dstack-vpc-client:\\n    image: nearaidev/dstack-vpc-client@sha256:dd570dee92901c6d9cf96909404bb5177294437e3642541225a85b06cefa3d9d\\n    container_name: dstack-vpc-client\\n    restart: on-failure\\n    cap_add:\\n      - NET_ADMIN\\n      - SYS_MODULE\\n    devices:\\n      - /dev/net/tun:/dev/net/tun\\n    network_mode: host\\n    volumes:\\n      - vpc_shared:/shared\\n      - vpc_node_data:/var/lib/tailscale\\n      - /var/run:/var/run\\n      - /dstack:/dstack\\n    environment:\\n      - NODE_NAME=cloud-api-prod\\n      - TUN_DEV_NAME=tailscale1\\n      - VPC_SERVER_APP_ID=e78c12915ad57900317b97bd16f59ae13f86f148\\n      - DSTACK_MESH_URL=http://localhost:9090\\n    healthcheck:\\n      test: [\\\"CMD\\\", \\\"tailscale\\\", \\\"status\\\"]\\n    labels:\\n      com.datadoghq.ad.logs: '[{\\\"source\\\": \\\"dstack-vpc-client\\\", \\\"service\\\": \\\"dstack-vpc-client\\\"}]'\\n    logging:\\n      driver: \\\"json-file\\\"\\n      options:\\n        max-size: \\\"100m\\\"\\n        max-file: \\\"10\\\"\\n        labels: \\\"com.datadoghq.ad.logs,com.docker.compose.service\\\"\\n\\n\\n  dstack-service-mesh:\\n    image: nearaidev/dstack-vpc@sha256:f04927ee68259f992fca9bb67618ac0f9c69faa314be08c31c840749691454e0\\n    container_name: dstack-service-mesh\\n    restart: on-failure\\n    ports:\\n      - \\\"443:443\\\"\\n      - \\\"9090:80\\\"\\n    volumes:\\n      - /var/run/dstack.sock:/var/run/dstack.sock\\n      - /var/run/docker.sock:/var/run/docker.sock\\n      - vpc_shared:/vpc/0:ro\\n    privileged: true\\n    environment:\\n      - DSTACK_GATEWAY_DOMAIN=cvm1.near.ai\\n      - DSTACK_MESH_BACKEND=127.0.0.1:8000\\n      - DSTACK_CONTAINER_IMAGE_ID=nearaidev/dstack-vpc@sha256:f04927ee68259f992fca9bb67618ac0f9c69faa314be08c31c840749691454e0\\n      - RUST_LOG=error\\n    command: /scripts/mesh-serve.sh\\n    labels:\\n      com.datadoghq.ad.logs: '[{\\\"source\\\": \\\"dstack-mesh\\\", \\\"service\\\": \\\"dstack-mesh\\\"}]'\\n    logging:\\n      driver: \\\"json-file\\\"\\n      options:\\n        max-size: \\\"100m\\\"\\n        max-file: \\\"10\\\"\\n        labels: \\\"com.datadoghq.ad.logs,com.docker.compose.service\\\"\\n\\n\\n  # Init container to prepare configuration\\n  api-init:\\n    image: alpine@sha256:4b7ce07002c69e8f3d704a9c5d6fd3053be500b7f1c69fc0d80990c2ad8dd412\\n    container_name: api-init\\n    restart: \\\"no\\\"\\n    volumes:\\n      - api_config:/config\\n      - vpc_shared:/shared\\n      - cloud-api-identity:/app-identity\\n      - otelcol-identity:/telemetry\\n    environment:\\n      # Consumed by the idle-connection reaper at the end of api_init_script:\\n      # discover the Patroni leader via the dstack gateway, then connect as the\\n      # postgres superuser to terminate stale idle backends before cloud-api starts.\\n      - POSTGRES_PRIMARY_APP_ID=c5f76292a3df94d50056b08e57fc30fe1081ad40\\n      - GATEWAY_SUBDOMAIN=cvm1.near.ai\\n      - DATABASE_NAME=${DATABASE_NAME}\\n      - DATABASE_USERNAME=${DATABASE_USERNAME}\\n    # Same resolver as cloud-api: 100.100.100.100 + dstack.internal search so the\\n    # reaper can resolve the leader's *.dstack.internal address; 1.1.1.1 for the\\n    # public gateway subdomain used during discovery.\\n    dns:\\n      - 100.100.100.100\\n      - 1.1.1.1\\n    dns_search:\\n      - dstack.internal\\n    configs:\\n      - source: api_init_script\\n        target: /init.sh\\n        mode: 0755\\n    command: [\\\"/init.sh\\\"]\\n\\n  # Cloud API service\\n  cloud-api:\\n    container_name: cloud-api\\n    image: nearaidev/cloud-api@sha256:ee6d566f75b8695fd980682d02764942a99f21c990f2c70272c93116609a7802\\n    restart: unless-stopped\\n    volumes:\\n      - /var/run/dstack.sock:/var/run/dstack.sock\\n      - api_config:/config:ro\\n      - cloud-api-identity:/run/cloud-api-identity:ro\\n      - ingress_certs:/ingress-certs:ro\\n    environment:\\n      - POSTGRES_PRIMARY_APP_ID=c5f76292a3df94d50056b08e57fc30fe1081ad40\\n      - VPC_SERVER_APP_ID=e78c12915ad57900317b97bd16f59ae13f86f148\\n      - SERVER_HOST=0.0.0.0\\n      - SERVER_PORT=3000\\n      - DATABASE_MAX_CONNECTIONS=32\\n      - DATABASE_REFRESH_INTERVAL=300\\n      - MODEL_DISCOVERY_SERVER_URL=${MODEL_DISCOVERY_SERVER_URL}\\n      - MODEL_DISCOVERY_API_KEY=${MODEL_DISCOVERY_API_KEY}\\n      # Per-model GPU allocation and burn metrics for the admin dashboard.\\n      # Values are written to the CVM .env file from the environment-specific\\n      # vars file and must also be forwarded into the cloud-api container.\\n      - INFRA_PROMETHEUS_URL=${INFRA_PROMETHEUS_URL}\\n      - INFRA_PROMETHEUS_BEARER_TOKEN=${INFRA_PROMETHEUS_BEARER_TOKEN}\\n      - INFRA_PROMETHEUS_ENV=${INFRA_PROMETHEUS_ENV}\\n      - INFRA_COST_PER_GPU_HOUR_USD=${INFRA_COST_PER_GPU_HOUR_USD}\\n      - ENABLE_ITA_ATTESTATION=true\\n      - ITA_API_KEY=${ITA_API_KEY}\\n      # Shared service-token for POST /v1/internal/usage. Forwarded\\n      # from the CVM .env file (written by Ansible from the host's\\n      # CLOUD_API_USAGE_TOKEN env var, in turn from the GH Actions\\n      # secret of the same name). When the .env doesn't define the\\n      # var, Docker Compose substitutes \\\"\\\" and cloud-api's config\\n      # layer coerces empty to None → endpoint stays disabled (503).\\n      - CLOUD_API_USAGE_TOKEN=${CLOUD_API_USAGE_TOKEN}\\n      - MODEL_DISCOVERY_REFRESH_INTERVAL=60\\n      - MODEL_DISCOVERY_TIMEOUT=5\\n      - LOG_LEVEL=info\\n      - LOG_FORMAT=json\\n      - RUST_LOG=info\\n      - RUST_BACKTRACE=1\\n      - LOG_MODULE_API=info\\n      - LOG_MODULE_SERVICES=info\\n      - DSTACK_CLIENT_URL=http://localhost:8000\\n      - AUTH_MOCK=false\\n      - GITHUB_CLIENT_ID=${GITHUB_CLIENT_ID}\\n      - GITHUB_CLIENT_SECRET=${GITHUB_CLIENT_SECRET}\\n      - GITHUB_REDIRECT_URL=https://cloud-api.near.ai/v1/auth/callback\\n      - GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}\\n      - GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET}\\n      - GOOGLE_REDIRECT_URL=https://cloud-api.near.ai/v1/auth/callback\\n      - NEAR_EXPECTED_RECIPIENT=${NEAR_EXPECTED_RECIPIENT}\\n      - AUTH_ADMIN_DOMAINS=${AUTH_ADMIN_DOMAINS}\\n      - DATABASE_NAME=${DATABASE_NAME}\\n      - DATABASE_USERNAME=${DATABASE_USERNAME}\\n      - DATABASE_TLS_ENABLED=true\\n      - DATABASE_PASSWORD_FILE=/config/postgres-password\\n      - AUTH_ENCODING_KEY=${AUTH_ENCODING_KEY}\\n      - VPC_HOSTNAME_FILE=/config/vpc_hostname\\n      - VPC_SHARED_SECRET_FILE=/config/keyfile\\n      - S3_ENCRYPTION_KEY_FILE=/config/s3-encryption-key\\n      # Domain-separated from the S3 key while retaining the VPC shared key as\\n      # the root secret. api-init writes the derived value to this private file.\\n      - DB_ENCRYPTION_KEY_FILE=/config/database-encryption-key\\n      - DB_ENCRYPTION_KEY_ID=${DB_ENCRYPTION_KEY_ID}\\n      - DB_ENCRYPTION_WRITE_ENABLED=${DB_ENCRYPTION_WRITE_ENABLED:-false}\\n      - AWS_S3_BUCKET=${AWS_S3_BUCKET}\\n      - AWS_S3_REGION=${AWS_S3_REGION}\\n      - AWS_REGION=${AWS_S3_REGION}\\n      - AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}\\n      - AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}\\n      - BRAVE_SEARCH_PRO_API_KEY=${BRAVE_SEARCH_PRO_API_KEY}\\n      - BRAVE_LLM_CONTEXT_API_KEY=${BRAVE_LLM_CONTEXT_API_KEY}\\n      - GATEWAY_SUBDOMAIN=cvm1.near.ai\\n      - CORS_ALLOWED_ORIGINS=${CORS_ALLOWED_ORIGINS}\\n      - ENVIRONMENT=prod\\n      # House of Stake farm credits (nearai/cloud-api#856). Shared template\\n      # passthroughs default hard-off so production remains disabled unless its\\n      # vars file explicitly opts in. Staging sets the contract/product IDs in\\n      # vars/cloud_api_stg.yaml.\\n      - STAKING_FARM_ENABLED=${STAKING_FARM_ENABLED:-false}\\n      - NEAR_RPC_URL=${NEAR_RPC_URL:-https://free.rpc.fastnear.com}\\n      - NEAR_NETWORK_ID=${NEAR_NETWORK_ID:-mainnet}\\n      - NEAR_STAKING_CONTRACT_ID=${NEAR_STAKING_CONTRACT_ID:-}\\n      - STAKING_FARM_PRODUCT_ID=${STAKING_FARM_PRODUCT_ID:-}\\n      - STAKING_FARM_PRICE_ID=${STAKING_FARM_PRICE_ID:-}\\n      - STAKING_FARM_CREDIT_NANO_USD_PER_REWARD_UNIT=${STAKING_FARM_CREDIT_NANO_USD_PER_REWARD_UNIT:-1000000000}\\n      - STAKING_FARM_SYNC_STALENESS_SECONDS=${STAKING_FARM_SYNC_STALENESS_SECONDS:-300}\\n      # Lukka AML checks for NEAR wallet-gated House of Stake flows\\n      # (nearai/cloud-api#909). This template forwards cloud-api's AML-scoped\\n      # env names; the vars files reuse the same per-environment Lukka secrets\\n      # already used by chat-api.\\n      - LUKKA_AML_ENABLED=${LUKKA_AML_ENABLED:-false}\\n      - LUKKA_AML_BEARER_TOKEN=${LUKKA_AML_BEARER_TOKEN:-}\\n      - LUKKA_AML_BASE_URL=${LUKKA_AML_BASE_URL:-https://api.blockchain-analytics.lukka.tech}\\n      - LUKKA_AML_REPORT_REFRESH_DAYS=${LUKKA_AML_REPORT_REFRESH_DAYS:-30}\\n      - LUKKA_AML_MEMORY_CACHE_TTL_SECONDS=${LUKKA_AML_MEMORY_CACHE_TTL_SECONDS:-300}\\n      - LUKKA_AML_REQUEST_TIMEOUT_SECONDS=${LUKKA_AML_REQUEST_TIMEOUT_SECONDS:-10}\\n      - LUKKA_AML_BLOCKED_RISK_LEVELS=${LUKKA_AML_BLOCKED_RISK_LEVELS:-}\\n      - LUKKA_AML_SCORE_BLOCK_THRESHOLD=${LUKKA_AML_SCORE_BLOCK_THRESHOLD:-46}\\n      - LUKKA_AML_HIGH_RISK_SLACK_WEBHOOK_URL=${LUKKA_AML_HIGH_RISK_SLACK_WEBHOOK_URL:-}\\n      - LUKKA_AML_HIGH_RISK_SLACK_TIMEOUT_MS=${LUKKA_AML_HIGH_RISK_SLACK_TIMEOUT_MS:-3000}\\n      - TELEMETRY_SERVICE_NAME=cloud-api\\n      - TELEMETRY_OTLP_ENDPOINT=http://otelcol-contrib:4317\\n      - TELEMETRY_SERVICE_INSTANCE_ID_FILE=/run/cloud-api-identity/instance_id\\n      - GEMINI_API_KEY=${GEMINI_API_KEY}\\n      - OPENAI_API_KEY=${OPENAI_API_KEY}\\n      - ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}\\n      # Native Anthropic Messages endpoints. Included only when an environment\\n      # explicitly opts in; production renders no setting and remains hard-off.\\n      - ENABLE_ANTHROPIC_MESSAGES=${ENABLE_ANTHROPIC_MESSAGES:-false}\\n      # Extra anthropic-beta tokens admitted by the native Messages routes on\\n      # top of the image's built-in allowlist. Rendered only when set.\\n      - ANTHROPIC_ALLOWED_BETAS=${ANTHROPIC_ALLOWED_BETAS:-}\\n      - EXTERNAL_PROVIDER_TIMEOUT=${EXTERNAL_PROVIDER_TIMEOUT}\\n      - INVITATION_EMAIL_ENABLED=${INVITATION_EMAIL_ENABLED}\\n      - INVITATION_EMAIL_FROM=${INVITATION_EMAIL_FROM}\\n      - RESEND_API_KEY=${RESEND_API_KEY}\\n      - CLOUD_UI_BASE_URL=${CLOUD_UI_BASE_URL}\\n      # Chutes attested third-party provider (nearai/cloud-api#758). Forwarded\\n      # from the CVM .env (set only where the vars file defines them — staging\\n      # for now). Missing → Compose substitutes the defaults below → cloud-api\\n      # keeps Chutes hard-off (ENABLE_CHUTES != \\\"true\\\"/\\\"1\\\"; empty key → None —\\n      # cloud-api config filters `CHUTES_API_KEY=\\\"\\\"` to absent via\\n      # `.filter(|s| !s.is_empty())`, so it fails closed (provider not registered);\\n      # empty CHUTES_MODELS → no models). So this passthrough is a no-op for\\n      # prod until its vars file opts in. CHUTES_ENABLE_STREAMING defaults off;\\n      # opt in per-environment via the vars file (see vars/cloud_api_stg.yaml for\\n      # the streaming-safety analysis). PCCS is intentionally omitted (unset →\\n      # dcap-qvl default collateral).\\n      # AUDIT NOTE: this template is shared with prod (vars/cloud_api_prod.yaml).\\n      # Adding these four passthroughs changes prod's rendered compose and thus its\\n      # KMS-registered attestation measurement; the daily 02:00 UTC\\n      # update_cloud_api_prod.yml cron re-registers it (idempotent add-hash with an\\n      # on-chain pre-check) within ~24h. Behaviorally a no-op for prod — the `:-`\\n      # defaults resolve Chutes hard-off — but the measurement digest does change.\\n      - ENABLE_CHUTES=${ENABLE_CHUTES:-false}\\n      - CHUTES_ENABLE_STREAMING=${CHUTES_ENABLE_STREAMING:-false}\\n      - CHUTES_MODELS=${CHUTES_MODELS:-}\\n      - CHUTES_API_KEY=${CHUTES_API_KEY:-}\\n      # OHTTP gateway (RFC 9458). Off by default; opt in per-environment\\n      # via env_vars (vars/cloud_api_stg.yaml sets OHTTP_ENABLED=true).\\n      - OHTTP_ENABLED=${OHTTP_ENABLED:-false}\\n      - TLS_CERT_PATH=/ingress-certs/cloud-api.near.ai/fullchain.pem\\n    dns:\\n      - 100.100.100.100\\n      - 1.1.1.1\\n    dns_search:\\n      - dstack.internal\\n    ports:\\n      - \\\"3000:3000\\\"\\n    depends_on:\\n      api-init:\\n        condition: service_completed_successfully\\n      ingress:\\n        condition: service_healthy\\n    healthcheck:\\n      test:\\n        [\\\"CMD-SHELL\\\", \\\"curl -f http://127.0.0.1:3000/v1/model/list || exit 1\\\"]\\n      interval: 30s\\n      timeout: 3s\\n      retries: 10\\n      start_period: 40s\\n    labels:\\n      com.datadoghq.ad.logs: '[{\\\"source\\\": \\\"cloud-api\\\", \\\"service\\\": \\\"cloud-api\\\"}]'\\n    logging:\\n      driver: \\\"json-file\\\"\\n      options:\\n        max-size: \\\"100m\\\"\\n        max-file: \\\"10\\\"\\n        labels: \\\"com.datadoghq.ad.logs,com.docker.compose.service\\\"\\n\\n\\n  # Ingress sidecar: nginx reverse proxy (TLS optional)\\n  ingress:\\n    container_name: ingress\\n    image: nearaidev/cvm-ingress@sha256:1653c23200298a823c08c66d829c633fc36919bca1e09cf577b83b01353e0891\\n    restart: unless-stopped\\n    environment:\\n      - DOMAIN=cloud-api.near.ai\\n      - BACKEND_HOST=cloud-api\\n      - BACKEND_PORT=3000\\n      - TLS_ENABLED=true\\n      - CERTBOT_EMAIL=${CERTBOT_EMAIL}\\n      - CLOUDFLARE_API_TOKEN=${CLOUDFLARE_API_TOKEN}\\n      - S3_BUCKET=${INGRESS_S3_BUCKET}\\n      - S3_PREFIX=cloud-api-prod\\n      - AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}\\n      - AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}\\n      - AWS_DEFAULT_REGION=${AWS_DEFAULT_REGION}\\n      - STAGING=false\\n    volumes:\\n      - /var/run/dstack.sock:/var/run/dstack.sock\\n      - ingress_certs:/certs\\n    ports:\\n      - \\\"8443:8443\\\"\\n    healthcheck:\\n      test: [\\\"CMD-SHELL\\\", \\\"test -f /certs/cloud-api.near.ai/fullchain.pem\\\"]\\n      interval: 5s\\n      timeout: 3s\\n      retries: 60\\n      start_period: 10s\\n    labels:\\n      com.datadoghq.ad.logs: '[{\\\"source\\\": \\\"nginx\\\", \\\"service\\\": \\\"ingress\\\", \\\"tags\\\": [\\\"role:ingress\\\", \\\"deployment:cloud-api-prod\\\", \\\"env:${ENV}\\\", \\\"host:${CVM_HOST}\\\", \\\"ip:${HOST_IP}\\\", \\\"port:8443\\\", \\\"domain:cloud-api.near.ai\\\"]}]'\\n    logging:\\n      driver: \\\"json-file\\\"\\n      options:\\n        max-size: \\\"100m\\\"\\n        max-file: \\\"10\\\"\\n        labels: \\\"com.datadoghq.ad.logs,com.docker.compose.service\\\"\\n\\n\\nvolumes:\\n  otelcol-storage:\\n  otelcol-identity:\\n\\n  cloud-api-identity:\\n  api_config:\\n  ingress_certs:\\n  # VPC Volumes\\n  vpc_shared:\\n  vpc_node_data:\\n\\n\\nconfigs:\\n  # Journald conf file content\\n  journald_config_file:\\n    content: |\\n      logs:\\n        - type: journald\\n          container_mode: true\\n          # TODO: Add filters to reduce log volume\\n\\n  # otelcol-contrib config for guest-level CVM telemetry. Dollar signs are\\n# escaped as $$ so docker compose leaves OTel's ${env:...} references intact.\\n  otelcol_cvm_config:\\n    content: |\\n      receivers:\\n        otlp:\\n          protocols:\\n            grpc:\\n              endpoint: 0.0.0.0:4317\\n            http:\\n              endpoint: 0.0.0.0:4318\\n\\n        filelog/docker_containers:\\n          include: [/var/lib/docker/containers/*/*-json.log]\\n          start_at: end\\n          storage: file_storage\\n          include_file_path: true\\n          operators:\\n            - type: json_parser\\n              parse_from: body\\n              parse_to: attributes\\n              timestamp:\\n                parse_from: attributes.time\\n                layout_type: gotime\\n                layout: '2006-01-02T15:04:05.999999999Z07:00'\\n              on_error: send_quiet\\n            - type: move\\n              from: attributes.log\\n              to: body\\n              if: 'attributes.log != nil'\\n            - type: move\\n              from: attributes.stream\\n              to: attributes[\\\"log.iostream\\\"]\\n              if: 'attributes.stream != nil'\\n            - type: remove\\n              field: attributes.time\\n              if: 'attributes.time != nil'\\n            - type: regex_parser\\n              parse_from: attributes[\\\"log.file.path\\\"]\\n              regex: '/var/lib/docker/containers/(?P<container_id>[a-f0-9]{12})[a-f0-9]*/'\\n              on_error: send_quiet\\n            # Preserve the low-cardinality Datadog autodiscovery tags operators\\n            # already use as log filters. High-cardinality tags like instance\\n            # and model_path stay inside the raw Docker label metadata.\\n            - type: regex_parser\\n              parse_from: attributes[\\\"attrs\\\"][\\\"com.datadoghq.ad.logs\\\"]\\n              regex: 'model:(?P<model>[^\\\",\\\\]]+)'\\n              on_error: send_quiet\\n            - type: regex_parser\\n              parse_from: attributes[\\\"attrs\\\"][\\\"com.datadoghq.ad.logs\\\"]\\n              regex: 'deployment:(?P<deployment>[^\\\",\\\\]]+)'\\n              on_error: send_quiet\\n            - type: regex_parser\\n              parse_from: attributes[\\\"attrs\\\"][\\\"com.datadoghq.ad.logs\\\"]\\n              regex: 'ip:(?P<ip>[^\\\",\\\\]]+)'\\n              on_error: send_quiet\\n            - type: regex_parser\\n              parse_from: attributes[\\\"attrs\\\"][\\\"com.datadoghq.ad.logs\\\"]\\n              regex: 'port:(?P<port>[^\\\",\\\\]]+)'\\n              on_error: send_quiet\\n            - type: regex_parser\\n              parse_from: attributes[\\\"attrs\\\"][\\\"com.datadoghq.ad.logs\\\"]\\n              regex: 'env:(?P<env>[^\\\",\\\\]]+)'\\n              on_error: send_quiet\\n            - type: regex_parser\\n              parse_from: attributes[\\\"attrs\\\"][\\\"com.datadoghq.ad.logs\\\"]\\n              regex: 'host:(?P<host>[^\\\",\\\\]]+)'\\n              on_error: send_quiet\\n            - type: add\\n              field: attributes[\\\"service.name\\\"]\\n              value: cvm-docker\\n\\n        hostmetrics/cvm:\\n          collection_interval: 30s\\n          root_path: $${env:CVM_HOSTMETRICS_ROOT_PATH}\\n          scrapers:\\n            cpu: {}\\n            memory: {}\\n            load: {}\\n            paging: {}\\n            network: {}\\n            disk: {}\\n            filesystem:\\n              exclude_mount_points:\\n                mount_points: [\\\"^/dev(/.*)?$\\\", \\\"^/proc(/.*)?$\\\", \\\"^/sys(/.*)?$\\\", \\\"^/run(/.*)?$\\\", \\\"^/var/lib/docker(/.*)?$\\\"]\\n                match_type: regexp\\n\\n        docker_stats/cvm:\\n          endpoint: unix:///var/run/docker.sock\\n          collection_interval: 30s\\n          timeout: 10s\\n          api_version: \\\"1.44\\\"\\n          container_labels_to_metric_labels:\\n            com.docker.compose.service: compose_service\\n            com.docker.compose.project: compose_project\\n\\n        prometheus/self:\\n          config:\\n            scrape_configs:\\n              - job_name: otelcol-cvm\\n                scrape_interval: 30s\\n                static_configs:\\n                  - targets: ['localhost:8888']\\n              - job_name: docker-labeled-services\\n                scrape_interval: 15s\\n                docker_sd_configs:\\n                  - host: unix:///var/run/docker.sock\\n                    refresh_interval: 30s\\n                relabel_configs:\\n                  - source_labels: [__meta_docker_container_label_nearai_otel_scrape]\\n                    regex: \\\"true\\\"\\n                    action: keep\\n                  - source_labels: [__meta_docker_network_name]\\n                    regex: dstack_default\\n                    action: keep\\n                  - source_labels: [__meta_docker_container_label_nearai_otel_port]\\n                    regex: \\\".+\\\"\\n                    action: keep\\n                  - source_labels: [__meta_docker_network_ip, __meta_docker_container_label_nearai_otel_port]\\n                    separator: \\\":\\\"\\n                    target_label: __address__\\n                    replacement: \\\"$$1:$$2\\\"\\n                  - source_labels: [__meta_docker_container_label_nearai_otel_path]\\n                    regex: \\\"(.+)\\\"\\n                    target_label: __metrics_path__\\n                  - source_labels: [__meta_docker_container_label_nearai_otel_job]\\n                    regex: \\\"(.+)\\\"\\n                    target_label: job\\n                  - source_labels: [__meta_docker_container_label_nearai_otel_service]\\n                    regex: \\\"(.+)\\\"\\n                    target_label: service\\n                  - source_labels: [__meta_docker_container_label_com_docker_compose_service]\\n                    regex: \\\"(.+)\\\"\\n                    target_label: container_name\\n                  - source_labels: [__meta_docker_container_label_nearai_otel_model]\\n                    regex: \\\"(.+)\\\"\\n                    target_label: model\\n                  - source_labels: [__meta_docker_container_label_nearai_otel_deployment]\\n                    regex: \\\"(.+)\\\"\\n                    target_label: deployment\\n                  - source_labels: [__meta_docker_container_label_nearai_otel_env]\\n                    regex: \\\"(.+)\\\"\\n                    target_label: env\\n                  - source_labels: [__meta_docker_container_label_nearai_otel_host]\\n                    regex: \\\"(.+)\\\"\\n                    target_label: host\\n                  - source_labels: [__meta_docker_container_label_nearai_otel_ip]\\n                    regex: \\\"(.+)\\\"\\n                    target_label: ip\\n                  - source_labels: [__meta_docker_container_label_nearai_otel_port]\\n                    regex: \\\"(.+)\\\"\\n                    target_label: port\\n              \\n        \\n\\n      processors:\\n        memory_limiter:\\n          check_interval: 1s\\n          limit_mib: 256\\n          spike_limit_mib: 64\\n\\n        resource:\\n          attributes:\\n            - key: host.name\\n              value: $${env:DD_HOSTNAME}\\n              action: upsert\\n            - key: cvm.name\\n              value: $${env:CVM_NAME}\\n              action: upsert\\n            - key: host.machine\\n              value: $${env:CVM_HOST}\\n              action: insert\\n            - key: deployment.environment\\n              value: $${env:ENV}\\n              action: upsert\\n            - key: service.namespace\\n              value: near-ai\\n              action: insert\\n\\n        \\n        resource/cvm_instance:\\n          attributes:\\n            - key: cvm.instance.id\\n              value: $${file:/telemetry/instance_id}\\n              action: upsert\\n\\n        # dstack-vpc-client writes instance_id with echo, so strip its trailing\\n        # newline before Prometheus converts cvm.instance.id to cvm_instance_id.\\n        transform/cvm_instance:\\n          error_mode: propagate\\n          metric_statements:\\n            - replace_pattern(resource.attributes[\\\"cvm.instance.id\\\"], \\\"\\\\\\\\s+$\\\", \\\"\\\")\\n            - delete_key(resource.attributes, \\\"cvm.instance.id\\\") where resource.attributes[\\\"cvm.instance.id\\\"] == \\\"unavailable\\\"\\n          log_statements:\\n            - context: resource\\n              statements:\\n                - replace_pattern(attributes[\\\"cvm.instance.id\\\"], \\\"\\\\\\\\s+$\\\", \\\"\\\")\\n                - delete_key(attributes, \\\"cvm.instance.id\\\") where attributes[\\\"cvm.instance.id\\\"] == \\\"unavailable\\\"\\n          trace_statements:\\n            - context: resource\\n              statements:\\n                - replace_pattern(attributes[\\\"cvm.instance.id\\\"], \\\"\\\\\\\\s+$\\\", \\\"\\\")\\n                - delete_key(attributes, \\\"cvm.instance.id\\\") where attributes[\\\"cvm.instance.id\\\"] == \\\"unavailable\\\"\\n        \\n\\n        transform/docker_metadata:\\n          error_mode: ignore\\n          log_statements:\\n            - context: log\\n              statements:\\n                - set(attributes[\\\"service.name\\\"], attributes[\\\"attrs\\\"][\\\"com.docker.compose.service\\\"]) where attributes[\\\"attrs\\\"] != nil and attributes[\\\"attrs\\\"][\\\"com.docker.compose.service\\\"] != nil\\n                - set(attributes[\\\"service.name\\\"], ParseJSON(attributes[\\\"attrs\\\"][\\\"com.datadoghq.ad.logs\\\"])[0][\\\"service\\\"]) where attributes[\\\"attrs\\\"] != nil and attributes[\\\"attrs\\\"][\\\"com.datadoghq.ad.logs\\\"] != nil\\n                - set(attributes[\\\"log.source\\\"], ParseJSON(attributes[\\\"attrs\\\"][\\\"com.datadoghq.ad.logs\\\"])[0][\\\"source\\\"]) where attributes[\\\"attrs\\\"] != nil and attributes[\\\"attrs\\\"][\\\"com.datadoghq.ad.logs\\\"] != nil\\n                - set(attributes[\\\"container.name\\\"], attributes[\\\"attrs\\\"][\\\"com.docker.compose.service\\\"]) where attributes[\\\"attrs\\\"] != nil and attributes[\\\"attrs\\\"][\\\"com.docker.compose.service\\\"] != nil\\n\\n        groupbyattrs/docker_service:\\n          keys:\\n            - service.name\\n            - container.name\\n            - log.source\\n            - log.iostream\\n            - model\\n            - deployment\\n            - env\\n            - host\\n            - ip\\n            - port\\n\\n        batch:\\n          send_batch_size: 1024\\n          send_batch_max_size: 2048\\n          timeout: 5s\\n\\n      exporters:\\n        otlphttp/gateway:\\n          endpoint: https://telemetry.infra.near.ai\\n          headers:\\n            Authorization: \\\"Bearer $${env:MONITORING_INGEST_TOKEN}\\\"\\n          # Keep source requests FIFO. The Collector default is ten queue\\n          # consumers; once they reorder cumulative samples, the gateway's\\n          # serialized remote-write queue cannot restore their order.\\n          sending_queue:\\n            num_consumers: 1\\n            queue_size: 128\\n            storage: file_storage\\n        \\n        otlp/datadog_agent:\\n          # Phase 4 double-ships app OTLP to Datadog while\\n          # cvm_datadog_enabled is true.\\n          endpoint: datadog-agent:4317\\n          tls:\\n            insecure: true\\n          sending_queue:\\n            queue_size: 128\\n            storage: file_storage\\n        \\n\\n      extensions:\\n        file_storage:\\n          directory: /var/lib/otelcol-contrib/storage\\n          create_directory: true\\n\\n      service:\\n        extensions: [file_storage]\\n        pipelines:\\n          logs/cvm:\\n            receivers: [filelog/docker_containers]\\n            processors: [memory_limiter, resource, resource/cvm_instance, transform/cvm_instance, transform/docker_metadata, groupbyattrs/docker_service, batch]\\n            exporters: [otlphttp/gateway]\\n          metrics/cvm_system:\\n            receivers: [hostmetrics/cvm, docker_stats/cvm]\\n            processors: [memory_limiter, resource, resource/cvm_instance, transform/cvm_instance, batch]\\n            exporters: [otlphttp/gateway]\\n          logs/otlp:\\n            receivers: [otlp]\\n            processors: [memory_limiter, resource, resource/cvm_instance, transform/cvm_instance, batch]\\n            exporters: [otlphttp/gateway, otlp/datadog_agent]\\n          metrics/self:\\n            receivers: [prometheus/self]\\n            processors: [memory_limiter, resource, resource/cvm_instance, transform/cvm_instance, batch]\\n            exporters: [otlphttp/gateway]\\n          \\n          metrics/otlp:\\n            receivers: [otlp]\\n            processors: [memory_limiter, resource, resource/cvm_instance, transform/cvm_instance, batch]\\n            exporters: [otlphttp/gateway, otlp/datadog_agent]\\n          traces:\\n            receivers: [otlp]\\n            processors: [memory_limiter, resource, resource/cvm_instance, transform/cvm_instance, batch]\\n            exporters: [otlphttp/gateway, otlp/datadog_agent]\\n        telemetry:\\n          metrics:\\n            address: localhost:8888\\n          logs:\\n            level: info\\n\\n\\n  api_init_script:\\n    content: |\\n      #!/bin/sh\\n      set -e\\n\\n      echo \\\"Cloud API initialization starting...\\\"\\n\\n      # Wait for file to exist in /shared\\n      echo \\\"Waiting for /shared/shared_key to exist...\\\"\\n      while [ ! -f /shared/shared_key ]; do\\n        sleep 2\\n      done\\n      echo \\\"/shared/shared_key exists\\\"\\n\\n      # Stage only the canonical dstack identity into separate app and collector\\n      # volumes. Neither consumer receives the credential-bearing VPC volume.\\n      INSTANCE_ID_WAIT_ATTEMPTS=$${INSTANCE_ID_WAIT_ATTEMPTS:-60}\\n      INSTANCE_ID_WAIT_SECONDS=$${INSTANCE_ID_WAIT_SECONDS:-2}\\n      echo \\\"Waiting for /shared/instance_id to exist...\\\"\\n      for _ in $$(seq 1 \\\"$$INSTANCE_ID_WAIT_ATTEMPTS\\\"); do\\n        if [ -s /shared/instance_id ]; then\\n          break\\n        fi\\n        sleep \\\"$$INSTANCE_ID_WAIT_SECONDS\\\"\\n      done\\n      if [ ! -s /shared/instance_id ]; then\\n        echo \\\"dstack instance identity was not staged\\\" >&2\\n        exit 1\\n      fi\\n      INSTANCE_ID=$$(sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$$//' /shared/instance_id)\\n      if [ -z \\\"$$INSTANCE_ID\\\" ]; then\\n        echo \\\"dstack instance identity is empty after trimming\\\" >&2\\n        exit 1\\n      fi\\n      umask 077\\n      printf '%s' \\\"$$INSTANCE_ID\\\" > /app-identity/instance_id\\n      printf '%s' \\\"$$INSTANCE_ID\\\" > /telemetry/instance_id\\n      chmod 0444 /app-identity/instance_id /telemetry/instance_id\\n      unset INSTANCE_ID\\n\\n      echo \\\"Copying shared key to /config/keyfile...\\\"\\n      cp /shared/shared_key /config/keyfile\\n      chmod 644 /config/keyfile\\n\\n      # Derive PostgreSQL password from keyfile (same algorithm as Patroni)\\n      POSTGRES_PASSWORD=$$(head -c 32 /config/keyfile | base64 | tr -d \\\"\\\\n\\\")\\n      echo \\\"$$POSTGRES_PASSWORD\\\" > /config/postgres-password\\n      chmod 644 /config/postgres-password\\n\\n      echo \\\"Copying actual hostname to /config/vpc_hostname...\\\"\\n      cp /shared/actual_hostname /config/vpc_hostname\\n      chmod 644 /config/vpc_hostname\\n\\n      # Derive S3 encryption key (32 bytes) from keyfile\\n      # Read 32 raw bytes, which are then converted to a 64-character hex string.\\n      S3_ENCRYPTION_KEY=$(head -c 32 /config/keyfile | xxd -p | tr -d '\\\\n')\\n      echo \\\"$$S3_ENCRYPTION_KEY\\\" > /config/s3-encryption-key\\n      chmod 644 /config/s3-encryption-key\\n\\n      # Derive a distinct database field-encryption key from the same VPC root\\n      # secret. The fixed domain label prevents reuse of the S3 key material;\\n      # the NUL delimiter is part of the versioned derivation. sha256sum emits\\n      # the 64 lowercase hex characters expected by cloud-api. Never log it.\\n      umask 077\\n      {\\n        printf 'nearai-cloud-api/database-field-encryption/v1\\\\000'\\n        cat /config/keyfile\\n      } | sha256sum | awk '{print $$1}' > /config/database-encryption-key\\n      # cloud-api runs as UID/GID 1000 and mounts api_config read-only.\\n      chown 1000:1000 /config/database-encryption-key\\n      chmod 600 /config/database-encryption-key\\n\\n      echo \\\"Initialization complete\\\"\\n\\n      # --- Best-effort: reap orphaned idle DB connections before cloud-api starts ---\\n      # On crash or redeploy, dead/old instances leave `idle` client backends that\\n      # nothing reaps (no server idle timeout; dead-peer TCP backends linger for\\n      # minutes). They fill the Patroni leader's max_connections and lock out even a\\n      # single healthy instance with \\\"FATAL: sorry, too many clients already\\\"\\n      # (incident 2026-06-15). cloud-api's own migration cannot fix this — it runs\\n      # AFTER the initial pool connect that is already failing — so clean up here,\\n      # first. Discover the leader via the Patroni REST API (through the dstack\\n      # gateway, the same path cloud-api uses for discovery) and connect as the\\n      # postgres superuser (which can use a reserved connection slot even when the\\n      # DB is full) to terminate stale idle backends and set a server-side idle\\n      # timeout going forward.\\n      #\\n      # Strictly best-effort: every failure path is swallowed and the container must\\n      # still exit 0 — this must NEVER block cloud-api from starting.\\n      set +e\\n      (\\n        apk add --no-cache postgresql-client curl jq >/dev/null 2>&1 \\\\\\n          || { echo \\\"[reap] apk add failed; skipping\\\"; exit 0; }\\n        export PGPASSWORD=\\\"$$(cat /config/postgres-password)\\\"\\n        export PGSSLMODE=require\\n        export PGCONNECT_TIMEOUT=10\\n        cluster_url=\\\"https://$${POSTGRES_PRIMARY_APP_ID}-8008.$${GATEWAY_SUBDOMAIN}/cluster\\\"\\n        echo \\\"[reap] discovering Patroni leader via $$cluster_url\\\"\\n        leader=\\\"$$(curl -fsSk --max-time 10 \\\"$$cluster_url\\\" \\\\\\n          | jq -r '.members[] | select(.role==\\\"leader\\\" or .role==\\\"master\\\") | .host' | head -n1)\\\"\\n        if [ -z \\\"$$leader\\\" ]; then echo \\\"[reap] no leader discovered; skipping\\\"; exit 0; fi\\n        echo \\\"[reap] leader=$$leader; terminating stale idle client backends\\\"\\n        psql -h \\\"$$leader\\\" -p 5432 -U \\\"$${DATABASE_USERNAME}\\\" -d \\\"$${DATABASE_NAME}\\\" --no-psqlrc -tA -c \\\\\\n          \\\"SELECT count(*) FROM (SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE backend_type='client backend' AND state='idle' AND pid<>pg_backend_pid() AND now()-state_change > interval '30 seconds') t;\\\" \\\\\\n          && echo \\\"[reap] terminated idle backends (count above)\\\"\\n        psql -h \\\"$$leader\\\" -p 5432 -U \\\"$${DATABASE_USERNAME}\\\" -d \\\"$${DATABASE_NAME}\\\" --no-psqlrc -tA -c \\\\\\n          \\\"ALTER DATABASE \\\\\\\"$${DATABASE_NAME}\\\\\\\" SET idle_session_timeout='300s'; ALTER DATABASE \\\\\\\"$${DATABASE_NAME}\\\\\\\" SET idle_in_transaction_session_timeout='60s';\\\" \\\\\\n          && echo \\\"[reap] set server-side idle timeouts (idle_session_timeout=300s)\\\"\\n      ) || true\\n      echo \\\"[reap] done\\\"\\n\",\n    \"kms_enabled\": true,\n    \"gateway_enabled\": true,\n    \"local_key_provider_enabled\": false,\n    \"key_provider_id\": \"\",\n    \"public_logs\": false,\n    \"public_sysinfo\": true,\n    \"allowed_envs\": [\n        \"DATABASE_NAME\",\n        \"DATABASE_USERNAME\",\n        \"MODEL_DISCOVERY_SERVER_URL\",\n        \"MODEL_DISCOVERY_API_KEY\",\n        \"INFRA_PROMETHEUS_URL\",\n        \"INFRA_PROMETHEUS_BEARER_TOKEN\",\n        \"INFRA_PROMETHEUS_ENV\",\n        \"INFRA_COST_PER_GPU_HOUR_USD\",\n        \"INFERENCE_API_KEY\",\n        \"CLOUD_API_USAGE_TOKEN\",\n        \"AUTH_ENCODING_KEY\",\n        \"DB_ENCRYPTION_KEY_ID\",\n        \"DB_ENCRYPTION_WRITE_ENABLED\",\n        \"GITHUB_CLIENT_ID\",\n        \"GITHUB_CLIENT_SECRET\",\n        \"GOOGLE_CLIENT_ID\",\n        \"GOOGLE_CLIENT_SECRET\",\n        \"AUTH_ADMIN_DOMAINS\",\n        \"AWS_S3_BUCKET\",\n        \"AWS_S3_REGION\",\n        \"AWS_REGION\",\n        \"AWS_ACCESS_KEY_ID\",\n        \"AWS_SECRET_ACCESS_KEY\",\n        \"BRAVE_SEARCH_PRO_API_KEY\",\n        \"BRAVE_LLM_CONTEXT_API_KEY\",\n        \"CORS_ALLOWED_ORIGINS\",\n        \"NEAR_EXPECTED_RECIPIENT\",\n        \"NEAR_RPC_URL\",\n        \"NEAR_NETWORK_ID\",\n        \"STAKING_FARM_ENABLED\",\n        \"NEAR_STAKING_CONTRACT_ID\",\n        \"STAKING_FARM_PRODUCT_ID\",\n        \"STAKING_FARM_PRICE_ID\",\n        \"STAKING_FARM_CREDIT_NANO_USD_PER_REWARD_UNIT\",\n        \"STAKING_FARM_SYNC_STALENESS_SECONDS\",\n        \"LUKKA_AML_ENABLED\",\n        \"LUKKA_AML_BEARER_TOKEN\",\n        \"LUKKA_AML_BASE_URL\",\n        \"LUKKA_AML_REPORT_REFRESH_DAYS\",\n        \"LUKKA_AML_MEMORY_CACHE_TTL_SECONDS\",\n        \"LUKKA_AML_REQUEST_TIMEOUT_SECONDS\",\n        \"LUKKA_AML_BLOCKED_RISK_LEVELS\",\n        \"LUKKA_AML_SCORE_BLOCK_THRESHOLD\",\n        \"LUKKA_AML_HIGH_RISK_SLACK_WEBHOOK_URL\",\n        \"LUKKA_AML_HIGH_RISK_SLACK_TIMEOUT_MS\",\n        \"GEMINI_API_KEY\",\n        \"OPENAI_API_KEY\",\n        \"ANTHROPIC_API_KEY\",\n        \"ENABLE_ANTHROPIC_MESSAGES\",\n        \"ANTHROPIC_ALLOWED_BETAS\",\n        \"EXTERNAL_PROVIDER_TIMEOUT\",\n        \"CERTBOT_EMAIL\",\n        \"CLOUDFLARE_API_TOKEN\",\n        \"INGRESS_S3_BUCKET\",\n        \"AWS_DEFAULT_REGION\",\n        \"INVITATION_EMAIL_ENABLED\",\n        \"INVITATION_EMAIL_FROM\",\n        \"RESEND_API_KEY\",\n        \"CLOUD_UI_BASE_URL\",\n        \"ITA_API_KEY\",\n        \"ENABLE_CHUTES\",\n        \"CHUTES_ENABLE_STREAMING\",\n        \"CHUTES_MODELS\",\n        \"CHUTES_API_KEY\",\n        \"OHTTP_ENABLED\",\n        \"DD_API_KEY\",\n        \"HUGGING_FACE_HUB_TOKEN\",\n        \"PROXY_TOKEN\",\n        \"ENV\",\n        \"HOST_IP\",\n        \"DD_HOSTNAME\",\n        \"MONITORING_INGEST_TOKEN\",\n        \"CVM_NAME\",\n        \"CVM_HOST\"\n    ],\n    \"no_instance_id\": false,\n    \"secure_time\": false\n}","event_log":[{"imr":0,"event_type":2147483659,"digest":"2e070cda358b5aa00f27cca25c47381bb564f4be3a84d059805a73cbbde764ed8341f7e09915b5e7b370f9c08a743fbd","event":"","event_payload":"095464785461626c65000100000000000000af96bb93f2b9b84e9462e0ba745642360090800000000000"},{"imr":0,"event_type":2147483658,"digest":"344bc51c980ba621aaa00da3ed7436f7d6e549197dfe699515dfa2c6583d95e6412af21c097d473155875ffd561d6790","event":"","event_payload":"2946762858585858585858582d585858582d585858582d585858582d58585858585858585858585829000000c0ff000000000040080000000000"},{"imr":0,"event_type":2147483649,"digest":"9dc3a1f80bcec915391dcda5ffbb15e7419f77eab462bbf72b42166fb70d50325e37b36f93537a863769bcf9bedae6fb","event":"","event_payload":"61dfe48bca93d211aa0d00e098032b8c0a00000000000000000000000000000053006500630075007200650042006f006f007400"},{"imr":0,"event_type":2147483649,"digest":"6f2e3cbc14f9def86980f5f66fd85e99d63e69a73014ed8a5633ce56eca5b64b692108c56110e22acadcef58c3250f1b","event":"","event_payload":"61dfe48bca93d211aa0d00e098032b8c0200000000000000000000000000000050004b00"},{"imr":0,"event_type":2147483649,"digest":"d607c0efb41c0d757d69bca0615c3a9ac0b1db06c557d992e906c6b7dee40e0e031640c7bfd7bcd35844ef9edeadc6f9","event":"","event_payload":"6